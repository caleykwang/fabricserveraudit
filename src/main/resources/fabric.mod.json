{
  "schemaVersion": 1,
  "id": "fabricserveraudit",
  "version": "${version}",
  "name": "Fabric Server Audit",
  "description": "Server-side connection and mod audit logging for Fabric Minecraft servers.",
  "authors": [
    "caleykwang"
  ],
  "contact": {
    "homepage": "https://github.com/caleykwang/fabricserveraudit",
    "sources": "https://github.com/caleykwang/fabricserveraudit"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": [
      "dev.caley.fabricserveraudit.FabricServerAudit"
    ]
  },
  "mixins": [
    "fabricserveraudit.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
